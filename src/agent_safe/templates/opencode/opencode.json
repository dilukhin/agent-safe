{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.key": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.pfx": "deny"
    },
    "skill": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "python -m agent_safe *": "allow",
      "safe *": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "Remove-Item *": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -df*": "deny",
      "git branch -D*": "deny",
      "git push --force*": "deny",
      "yc * delete *": "deny",
      "yc * remove *": "deny",
      "shutdown *": "deny",
      "Restart-Computer *": "deny",
      "Stop-Computer *": "deny",
      "curl *|*sh*": "deny",
      "wget *|*sh*": "deny",
      "iwr *|*iex*": "deny",
      "Invoke-Expression *": "deny",
      "iex *": "deny"
    },
    "edit": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
